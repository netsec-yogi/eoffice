APP_NAME="Digital Workflow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100
APP_PORT=8100
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=digital_workflow
DB_USERNAME=workflow
DB_PASSWORD=secret
FORWARD_DB_PORT=54330

SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="workflow@institute.test"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_UI_PORT=8028

# --- Institutional directory (OpenLDAP) ------------------------------------
# Development values point at the bundled `ldap` container (synthetic data).
# Production: LDAPS (port 636, LDAP_SSL=true) or StartTLS (LDAP_TLS=true),
# with LDAP_CA_CERT set to the institute CA bundle. Never disable validation.
LDAP_ENABLED=true
LDAP_HOSTS=ldap
LDAP_PORT=389
LDAP_BASE_DN="dc=institute,dc=test"
LDAP_PEOPLE_DN="ou=people,dc=institute,dc=test"
LDAP_USERNAME="cn=workflow-bind,dc=institute,dc=test"
LDAP_PASSWORD=dev-bind-secret
LDAP_SSL=false
LDAP_TLS=true
LDAP_CA_CERT=/etc/ldap-certs/ca.crt
LDAP_TIMEOUT=5
LDAP_LOGIN_ATTRIBUTE=uid
LDAP_USER_FILTER="(objectClass=inetOrgPerson)"
LDAP_LOGGING=false

# Development directory container only.
LDAP_DEV_ADMIN_PASSWORD=dev-admin-secret
LDAP_DEV_READONLY_USER=workflow-bind
LDAP_DEV_READONLY_PASSWORD=dev-bind-secret

# --- Computer Centre integrations (config/computer_centre.php) -----------
# "none" turns a step into a manual task for the Computer Centre.
CC_MAIL_DRIVER=none
CC_MAIL_DOMAIN=institute.test
# Development: the bundled directory's admin modifies the access groups.
# Production: a dedicated account allowed to modify only these groups.
CC_NETWORK_DRIVER=ldap
CC_WIFI_GROUP_DN="cn=wifi-users,ou=groups,dc=institute,dc=test"
CC_VPN_GROUP_DN="cn=vpn-users,ou=groups,dc=institute,dc=test"
CC_LDAP_PROVISION_DN="cn=admin,dc=institute,dc=test"
CC_LDAP_PROVISION_PASSWORD=dev-admin-secret
CC_VM_DRIVER=none
# PROXMOX_URL=https://pve.example:8006
# PROXMOX_TOKEN_ID=workflow@pve!provision
# PROXMOX_TOKEN_SECRET=
# PROXMOX_NODE=pve1
# PROXMOX_TEMPLATE_UBUNTU=9000

# --- First system administrator (seeded; must also exist in LDAP) ----------
SEED_ADMIN_USERNAME=rverma

# --- Notification channels (see docs/INTEGRATIONS.md) ----------------------
# Drivers: log (development), or a provider adapter once credentials exist.
SMS_DRIVER=log
WHATSAPP_DRIVER=log

VITE_APP_NAME="${APP_NAME}"

# Printed on official PDF forms (docs/OFFICIAL_PDF_TEMPLATES.md)
INSTITUTE_NAME=
INSTITUTE_SHORT_NAME=
INSTITUTE_ADDRESS=
INSTITUTE_CITY=
